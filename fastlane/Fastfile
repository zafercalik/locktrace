require "fileutils"

default_platform(:ios)

platform :ios do
  desc "Build signed IPA and upload to TestFlight (manual signing)"
  lane :beta do
    setup_ci if ENV["CI"]

    project_root = File.expand_path("..", __dir__)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_P8"),
      duration: 1200,
      in_house: false
    )

    keychain_name = ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain")
    keychain_password = ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")

    if ENV["IOS_DIST_CERTIFICATE_P12_PATH"]
      cert_path = File.expand_path(ENV["IOS_DIST_CERTIFICATE_P12_PATH"], project_root)
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV.fetch("IOS_DIST_CERTIFICATE_PASSWORD"),
        keychain_name: keychain_name,
        keychain_password: keychain_password,
        log_output: true
      )
    end

    profile_path = File.expand_path(ENV.fetch("IOS_PROVISIONING_PROFILE_PATH"), project_root)
    UI.user_error!("Provisioning profile not found at #{profile_path}") unless File.exist?(profile_path)
    install_provisioning_profile(path: profile_path)

    # Read the real profile Name from the .mobileprovision (do not hardcode).
    profile_plist_path = File.join(project_root, "signing", "profile.plist")
    FileUtils.mkdir_p(File.dirname(profile_plist_path))
    sh("security cms -D -i '#{profile_path}' -o '#{profile_plist_path}'")
    profile_name = sh("/usr/libexec/PlistBuddy -c 'Print :Name' '#{profile_plist_path}'").to_s.strip
    profile_uuid = sh("/usr/libexec/PlistBuddy -c 'Print :UUID' '#{profile_plist_path}'").to_s.strip
    UI.message("Using provisioning profile '#{profile_name}' (#{profile_uuid})")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.join(project_root, "BreakLock2.xcodeproj"),
      team_id: "3GH7A9N6BH",
      targets: ["BreakLock2"],
      build_configurations: ["Release"],
      code_sign_identity: "iPhone Distribution",
      profile_name: profile_name,
      bundle_identifier: "zetbilisim.BreakLock"
    )

    update_project_provisioning(
      xcodeproj: File.join(project_root, "BreakLock2.xcodeproj"),
      profile: profile_path,
      target_filter: "^BreakLock2$",
      build_configuration: "Release",
      code_signing_identity: "iPhone Distribution"
    )

    # Clear sdk-specific hardcoded specifier so Xcode uses the installed profile name.
    pbxproj_path = File.join(project_root, "BreakLock2.xcodeproj", "project.pbxproj")
    project_pbxproj = File.read(pbxproj_path)
    project_pbxproj.gsub!(
      /"PROVISIONING_PROFILE_SPECIFIER\[sdk=iphoneos\*\]" = [^;]+;/,
      "\"PROVISIONING_PROFILE_SPECIFIER[sdk=iphoneos*]\" = \"#{profile_name}\";"
    )
    File.write(pbxproj_path, project_pbxproj)

    build_number = (
      latest_testflight_build_number(
        api_key: api_key,
        app_identifier: "zetbilisim.BreakLock",
        initial_build_number: 1
      ) + 1
    ).to_s

    increment_build_number(
      build_number: build_number,
      xcodeproj: File.join(project_root, "BreakLock2.xcodeproj")
    )

    build_app(
      project: File.join(project_root, "BreakLock2.xcodeproj"),
      scheme: "BreakLock2",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: File.join(project_root, "build"),
      output_name: "BreakLock2",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: "3GH7A9N6BH",
        provisioningProfiles: {
          "zetbilisim.BreakLock" => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "zetbilisim.BreakLock",
      apple_id: "6748566579",
      # Declares export compliance via ASC API ("No" to non-exempt encryption).
      uses_non_exempt_encryption: false,
      # Wait until Apple finishes processing so the build becomes Ready to Test.
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false
    )
  end
end
